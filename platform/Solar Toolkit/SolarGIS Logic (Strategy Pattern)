{"cells":[{"cell_type":"code","source":"\"\"\"\nSolarGIS POA Data Import Module (Refactored using Strategy Pattern)\n\"\"\"\nimport os\nimport re\nimport pandas as pd\nfrom typing import Dict, List, Optional, Tuple, Any\nfrom abc import ABC, abstractmethod\nfrom difflib import SequenceMatcher\n\nclass SolarGISStrategy(ABC):\n    \"\"\"Abstract base strategy for parsing SolarGIS CSV formats.\"\"\"\n    \n    @abstractmethod\n    def matches(self, df: pd.DataFrame, mapping: Dict) -> bool:\n        \"\"\"Return True if this strategy can handle the dataframe.\"\"\"\n        pass\n\n    @abstractmethod\n    def parse_metadata(self, df: pd.DataFrame, mapping: Dict) -> Dict[str, Any]:\n        \"\"\"Refine the mapping with format-specific metadata.\"\"\"\n        pass\n\nclass RowBasedOrientationStrategy(SolarGISStrategy):\n    \"\"\"\n    Handles formats where different orientations (arrays) are stacked in rows.\n    Detected if multiple unique azimuth/slope combinations exist in columns.\n    \"\"\"\n    def matches(self, df: pd.DataFrame, mapping: Dict) -> bool:\n        unique_orientations = self._get_unique_orientations(df, mapping)\n        return len(unique_orientations) > 1\n\n    def parse_metadata(self, df: pd.DataFrame, mapping: Dict) -> Dict[str, Any]:\n        mapping['split_by_orientation'] = True\n        mapping['orientations'] = self._get_unique_orientations(df, mapping)\n        \n        # Find GTI column\n        gti_cols = self._find_gti_columns(df, mapping['timestamp'])\n        if gti_cols:\n            mapping['gti_col'] = gti_cols[0]\n            \n        return mapping\n\n    def _get_unique_orientations(self, df: pd.DataFrame, mapping: Dict) -> List[Dict]:\n        az_col = mapping.get('azimuth_col')\n        sl_col = mapping.get('slope_col')\n        cap_col = mapping.get('capacity_col')\n        \n        if not (az_col and sl_col):\n            return []\n            \n        cols = [az_col, sl_col]\n        if cap_col: cols.append(cap_col)\n        \n        unique = df[cols].drop_duplicates()\n        results = []\n        for _, row in unique.iterrows():\n            results.append({\n                'azimuth': row[az_col],\n                'slope': row[sl_col],\n                'capacity': row[cap_col] if cap_col and pd.notna(row[cap_col]) else None\n            })\n        return results\n\n    def _find_gti_columns(self, df: pd.DataFrame, ts_col: str) -> List[str]:\n        gti = []\n        for col in df.columns:\n            if col == ts_col: continue\n            cl = col.lower()\n            if any(x in cl for x in ['gti', 'ghi', 'poa', 'irradiance']):\n                if not any(x in cl for x in ['azimuth', 'slope', 'name']):\n                    gti.append(col)\n        return gti\n\nclass ColumnBasedArrayStrategy(SolarGISStrategy):\n    \"\"\"\n    Handles formats where arrays are wide (Array1, Array2 columns).\n    \"\"\"\n    def matches(self, df: pd.DataFrame, mapping: Dict) -> bool:\n        # Matches if not row-based (default fallback usually)\n        return True\n\n    def parse_metadata(self, df: pd.DataFrame, mapping: Dict) -> Dict[str, Any]:\n        mapping['arrays'] = {}\n        array_pattern = re.compile(r'array[\\s_]*(\\d+)', re.IGNORECASE)\n        cap_pattern = re.compile(r'(\\d+(?:\\.\\d+)?)\\s*(?:kw|mw)', re.IGNORECASE)\n        \n        gti_cols = self._find_gti_columns(df, mapping['timestamp'])\n        \n        for col in gti_cols:\n            match = array_pattern.search(col)\n            array_id = f\"Array{match.group(1)}\" if match else f\"Array{len(mapping['arrays'])+1}\"\n            \n            # Extract capacity from header if possible\n            cap = None\n            cap_match = cap_pattern.search(col)\n            if cap_match:\n                cap = float(cap_match.group(1))\n                if 'mw' in col.lower(): cap *= 1000\n            \n            # Extract azimuth/slope from single-value columns if they exist\n            az = float(df[mapping['azimuth_col']].iloc[0]) if mapping.get('azimuth_col') else 0.0\n            sl = float(df[mapping['slope_col']].iloc[0]) if mapping.get('slope_col') else 0.0\n            \n            mapping['arrays'][array_id] = {\n                'poa_col': col,\n                'capacity': cap,\n                'azimuth': az,\n                'slope': sl\n            }\n        return mapping\n\n    def _find_gti_columns(self, df: pd.DataFrame, ts_col: str) -> List[str]:\n        # Same helper, usually part of a Base/Mixin in full implementation\n        gti = []\n        for col in df.columns:\n            if col == ts_col: continue\n            cl = col.lower()\n            if any(x in cl for x in ['gti', 'ghi', 'poa', 'irradiance']) or 'array' in cl:\n                if not any(x in cl for x in ['azimuth', 'slope', 'name', 'cap']):\n                    gti.append(col)\n        return gti\n\nclass SolarGISImporter:\n    \"\"\"Context class for loading SolarGIS data.\"\"\"\n    \n    def __init__(self):\n        self.strategies = [RowBasedOrientationStrategy(), ColumnBasedArrayStrategy()]\n\n    def load(self, filepath: str) -> Tuple[pd.DataFrame, Dict]:\n        for encoding in ['utf-8', 'latin1', 'cp1252']:\n            for skiprows in [0, 1, 2, 3]:\n                try:\n                    df = pd.read_csv(filepath, encoding=encoding, skiprows=skiprows)\n                    if len(df) > 0 and len(df.columns) > 1:\n                        mapping = self._detect_basic_columns(df)\n                        if 'timestamp' in mapping:\n                            # Select Strategy\n                            for strategy in self.strategies:\n                                if strategy.matches(df, mapping):\n                                    mapping = strategy.parse_metadata(df, mapping)\n                                    return df, mapping\n                except Exception:\n                    continue\n        raise ValueError(f\"Could not parse SolarGIS file: {filepath}\")\n\n    def _detect_basic_columns(self, df: pd.DataFrame) -> Dict:\n        mapping = {}\n        # Find timestamp\n        ts_patterns = ['date', 'time', 'datetime', 'timestamp', 'utc']\n        for col in df.columns:\n            if any(p in col.lower() for p in ts_patterns):\n                mapping['timestamp'] = col\n                break\n        if 'timestamp' not in mapping:\n            mapping['timestamp'] = df.columns[0]\n            \n        # Find basic metadata columns\n        for col in df.columns:\n            cl = col.lower()\n            if 'azimuth' in cl: mapping['azimuth_col'] = col\n            elif 'slope' in cl or 'tilt' in cl: mapping['slope_col'] = col\n            elif 'array_cap' in cl or cl == 'array_capacity': mapping['capacity_col'] = col\n            \n        return mapping\n\ndef fuzzy_match_filename(plant_name: str, filenames: List[str], threshold: float = 0.6) -> Optional[str]:\n    best_match, best_score = None, 0.0\n    plant_lower = plant_name.lower().replace(\"_\", \" \").replace(\"-\", \" \")\n    for filename in filenames:\n        base = os.path.splitext(filename)[0].lower().replace(\"_\", \" \").replace(\"-\", \" \")\n        score = SequenceMatcher(None, plant_lower, base).ratio()\n        if score > best_score and score >= threshold:\n            best_score = score\n            best_match = filename\n    return best_match","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}