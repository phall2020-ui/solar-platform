{"cells":[{"cell_type":"code","source":"\"\"\"\nOrchestrator: The Controller Layer.\nIntegrates all analysis and data modules (Fetch, Fouling, Shading, POA Import).\n\"\"\"\nimport os\nimport logging\nimport pandas as pd\nfrom typing import Optional, List, Tuple\nfrom solar_toolkit.config import settings\nfrom solar_toolkit.utils import logger, date_range_to_ts\n\n# Modules\nfrom solar_toolkit.data.store import PlantStore\nfrom solar_toolkit.data.fetcher import FetchConfig, fetch_all_readings, write_combined_csv, get_plant_devices\nfrom solar_toolkit.data.poa_importer import import_solargis_data\nfrom solar_toolkit.core.fouling import FoulingConfig, run_fouling_analysis, auto_select_clean_period, filter_by_date_range\nfrom solar_toolkit.core.shading import ShadingSettings, load_and_prepare, process_season, generate_plots\n\nclass AnalysisOrchestrator:\n    def __init__(self, db_path: str = None):\n        self.db_path = db_path or settings.DB_PATH\n        self.store = PlantStore(self.db_path)\n\n    # --- PLANT REGISTRY ---\n    def get_plants(self):\n        return self.store.list_all()\n        \n    def save_plant(self, alias: str, uid: str, inv_ids: List[str], weth_id: Optional[str], dc_size: Optional[float]):\n        self.store.save(alias, uid, inv_ids, weth_id, dc_size)\n        \n    def get_plant_devices(self, alias: str) -> List[str]:\n        rec = self.store.load(alias)\n        if rec:\n            return rec.get('inverter_ids', []) + ([rec['weather_id']] if rec.get('weather_id') else [])\n        return []\n\n    # --- FOULING ANALYSIS ---\n    def run_fouling_auto(self, data_source_path: str, dc_size: float, auto_days: int = 3) -> dict:\n        \"\"\"Runs fouling analysis using auto-selected clean period from a single CSV.\"\"\"\n        if not os.path.exists(data_source_path):\n            raise FileNotFoundError(f\"Data source file not found: {data_source_path}\")\n\n        # The 'ts' column is automatically detected and handled in prepare_data\n        df = pd.read_csv(data_source_path)\n        cfg = FoulingConfig(dc_size_kw=dc_size)\n        \n        logger.info(f\"Attempting to auto-select a {auto_days}-day clean period.\")\n        clean_df, (start_dt, end_dt) = auto_select_clean_period(df, cfg, days=auto_days)\n            \n        if clean_df.empty:\n            raise ValueError(\"Could not determine a valid clean period for baseline calculation.\")\n        \n        logger.info(f\"Auto-selected clean period: {start_dt} to {end_dt}\")\n        return run_fouling_analysis(df, clean_df, cfg)\n        \n    # --- SHADING ANALYSIS ---\n    def run_shading_analysis(self, summer_csv: str, winter_csv: str, output_base: str):\n        \"\"\"Runs shading analysis comparing two seasonal CSV files.\"\"\"\n        cfg = ShadingSettings()\n        \n        # 1. Load and Prepare\n        # This function handles column detection and data cleaning\n        inv_s, w_s, _, p_col = load_and_prepare(summer_csv, cfg)\n        inv_w, w_w, _, _ = load_and_prepare(winter_csv, cfg)\n        logger.info(f\"Using power column: {p_col}\")\n        \n        # 2. Process Seasons\n        prof_s = process_season(inv_s, w_s, p_col, cfg)\n        prof_w = process_season(inv_w, w_w, p_col, cfg)\n        \n        # 3. Compare and Merge\n        m = prof_s.merge(prof_w, on=[cfg.emigid_col, \"hour_float\"], suffixes=('_summer', '_winter'))\n        m[\"ratio\"] = m[\"eff_winter\"] / m[\"eff_summer\"]\n        \n        # 4. Save Outputs\n        if output_base:\n            pdf_path = f\"{output_base}.pdf\"\n            detail_path = f\"{output_base}_detail.csv\"\n            # Plotting uses Matplotlib, which may be slow for large datasets\n            generate_plots(m, pdf_path, cfg)\n            m.to_csv(detail_path, index=False)\n            logger.info(f\"Shading plots saved to {pdf_path}\")\n            logger.info(f\"Detailed analysis saved to {detail_path}\")\n            \n        return m\n\n    # --- DATA FETCHING (Juggle API) ---\n    def fetch_data(self, plant_uid: str, start: str, end: str, output: Optional[str] = None):\n        \"\"\"Fetches inverter and weather data from Juggle API and stores it.\"\"\"\n        if not settings.JUGGLE_API_KEY:\n            raise ValueError(\"API Key not set in environment variable JUGGLE_API_KEY.\")\n\n        cfg = FetchConfig(\n            api_key=settings.JUGGLE_API_KEY,\n            plant_uid=plant_uid,\n            start_date=start,\n            end_date=end,\n            min_interval_s=settings.DEFAULT_MIN_INTERVAL_S\n        )\n\n        logger.info(f\"Discovering devices for {plant_uid}...\")\n        inv_ids = get_plant_devices(cfg)\n        logger.info(f\"Found {len(inv_ids)} inverters.\")\n        \n        # Look up weather station ID from the registry\n        plant_rec = next((p for p in self.get_plants() if p.get('plant_uid') == plant_uid), None)\n        weather_id = plant_rec.get('weather_id') if plant_rec else None\n\n        all_emig_ids = inv_ids + ([weather_id] if weather_id else [])\n        all_readings = []\n        \n        # Fetch data for all inverters and the weather station\n        for emig_id in all_emig_ids:\n            logger.info(f\"Fetching {emig_id}...\")\n            readings = fetch_all_readings(cfg, emig_id)\n            all_readings.extend(readings)\n            \n            # Store in DB\n            self.store.store_readings(plant_uid, emig_id, readings)\n            \n        if output and all_readings:\n            write_combined_csv(all_readings, output)\n            \n        return len(all_readings)\n        \n    # --- POA IMPORT (SolarGIS) ---\n    def import_poa(self, plant_alias: str, solargis_folder: str, start_date: str, end_date: str) -> int:\n        \"\"\"Imports POA data from SolarGIS CSV files.\"\"\"\n        return import_solargis_data(plant_alias, solargis_folder, start_date, end_date, self.store)","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}