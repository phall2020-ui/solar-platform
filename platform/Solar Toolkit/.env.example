# Solar Toolkit Environment Configuration
# Copy this file to .env and fill in your credentials

# --- Juggle Energy API (Standard Fetch) ---
JUGGLE_API_KEY=your-api-key-here
JUGGLE_BASE_URL=https://api.juggle.energy/v1

# --- Juggle Web Crawler (For Missing Devices) ---
JUGGLE_USERNAME=your-email@example.com
JUGGLE_PASSWORD=your-password-here
EMIG_API_KEY=your-emig-api-key-here
EMIG_API_URL=https://www.emig.co.uk/p/api

# --- Crawler Settings ---
# Set to "false" to see the browser window during crawling (useful for debugging)
CRAWLER_HEADLESS=true

# --- Data Settings ---
# Default interval in seconds (900 = 15 minutes)
DEFAULT_MIN_INTERVAL_S=900
