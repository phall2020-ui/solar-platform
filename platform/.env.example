# ═══════════════════════════════════════════════════════════════════════
# Solar Portfolio Manager — Environment Configuration
# Copy to .env and fill in the values for your environment.
# ═══════════════════════════════════════════════════════════════════════

# ── Environment ─────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────────────────
# Current backend: duckdb (default) | postgresql (future)
DB_BACKEND=duckdb

# DuckDB — path to the unified database file
# Leave blank to auto-resolve from GOOGLE_DRIVE_SYNC_PATH or ~/.solar_toolkit/
UNIFIED_DB_PATH=

# Legacy path overrides (also respected by app_config)
TOOLKIT_DB_PATH=
REPORTING_DB_PATH=

# PostgreSQL / TimescaleDB (future)
DATABASE_URL=

# Google Drive sync path for cross-device database sharing
# Example: ~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/SolarPortfolioManager/databases
GOOGLE_DRIVE_SYNC_PATH=

# ── API Keys ────────────────────────────────────────────────────────────
EMIG_API_KEY=
JUGGLE_API_KEY=
NREL_API_KEY=
SOLARGIS_API_KEY=

# ── Notion (Asset Register) ─────────────────────────────────────────────
# Enable pulling asset-register metadata into Plant Detail pages.
NOTION_ASSET_SYNC_ENABLED=false

# Preferred names for the portal app:
NOTION_INTEGRATION_TOKEN=
NOTION_ASSET_DATABASE_ID=

# Back-compat with existing repo scripts/workflows:
NOTION_TOKEN=
NOTION_DB_ID=

# Optional overrides (match Notion column names)
NOTION_ASSET_PLANT_UID_FIELD=Plant UID
NOTION_ASSET_ALIAS_FIELD=Alias
NOTION_ASSET_CACHE_TTL_SECONDS=300

# ── Feature Flags ───────────────────────────────────────────────────────
# Enable live auto-refresh on the Site Monitor page
FEATURE_LIVE_MODE=true

# Use materialised views for faster dashboard queries
USE_CACHED_VIEWS=false

# Run background batch/ETL jobs
ENABLE_BACKGROUND_JOBS=false

# Emit structured observability metrics
ENABLE_OBSERVABILITY=true

# ── Polling & Refresh ───────────────────────────────────────────────────
# Live-mode refresh interval (seconds, min 5, max 300)
LIVE_POLL_INTERVAL_SECONDS=30

# Query cache time-to-live (seconds, 0 = no caching)
QUERY_CACHE_TTL=300
MAX_QUERY_RESULTS=10000

# ── Alert Thresholds ───────────────────────────────────────────────────
# Performance Ratio below this triggers a warning
ALERT_PR_LOW=0.70

# Availability (%) below this triggers a warning
ALERT_AVAILABILITY_LOW=95.0

# Gap in data (minutes) that triggers a data-gap alert
ALERT_DATA_GAP_MINUTES=60

# ── Cache Backend ───────────────────────────────────────────────────────
# Options: memory (default) | redis (future)
CACHE_BACKEND=memory

# Redis URL (only used when CACHE_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# ── Streamlit ───────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: console | json
LOG_FORMAT=console

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
DEFAULT_ADMIN_PASSWORD=

# ── Email (future) ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ampyr.com

# ── Slack (future) ──────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
