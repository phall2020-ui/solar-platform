# Solar-Platform Environment Variables

# Notion Configuration
NOTION_TOKEN=your_notion_token_here
NOTION_PAGE_ID=your_notion_page_id_here
NOTION_DB_ID=your_notion_database_id_here
NOTION_DAILY_JSON_DATABASE_ID=your_secondary_database_id_here
NOTION_ASSET_SYNC_ENABLED=true

# Juggle API Configuration
JUGGLE_API_KEY=your_juggle_api_key_here
JUGGLE_PLANT_UID=ERS:00001
JUGGLE_REQUEST_TIMEOUT_S=30
JUGGLE_REQUEST_RETRIES=3

# Solis API Configuration
SOLIS_API_URL=https://www.soliscloud.com:13333
SOLIS_KEY_ID=your_solis_key_id_here
SOLIS_KEY_SECRET=your_solis_key_secret_here

# SolarEdge Configuration
# Format: {"site_id": "api_key", ...}
SOLAREDGE_KEYS_JSON='{}'

# Sync Settings
SYNC_TIMEZONE=Europe/London
SYNC_LAG_DAYS=1
SYNC_MONTH_CLOSE_GRACE_DAYS=3
SYNC_SNAPSHOT_DIR=sync_snapshots

# SMTP Configuration for Alerts
SYNC_SMTP_SERVER=smtp.gmail.com
SYNC_SMTP_PORT=587
SYNC_SMTP_USERNAME=your_email@example.com
SYNC_SMTP_PASSWORD=your_app_password_here
SYNC_SMTP_USE_TLS=true
SYNC_EMAIL_FROM=alerts@example.com
SYNC_EMAIL_TO=recipient1@example.com,recipient2@example.com

# GitHub Integration
REPO_DISPATCH_TOKEN=your_github_pat_here
