<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peterhall.inverter-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/peterhall/Projects/solar-platform/.venv/bin/solar-monitor</string>
        <string>--schedule</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/peterhall/Projects/solar-platform</string>

    <!-- Poll every 2 hours; daemon also does internal solar-aware gating via astral -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/peterhall/Projects/solar-platform/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/peterhall/Projects/solar-platform/logs/launchd_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/peterhall/Projects/solar-platform/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
